# Production domain, no trailing slash. Used for canonical URLs, sitemap.xml, robots.txt and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional: the content value from Google Search Console's "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=

# Supabase Auth for the admin login (public values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Express backend (admin saves, uploads, enquiry form)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-only. Must match REVALIDATE_SECRET in backend/.env
REVALIDATE_SECRET=
# Optional server-side backend address (defaults to NEXT_PUBLIC_API_URL)
API_URL=
