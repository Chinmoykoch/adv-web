# AdventureCarz: one repository for both apps (backend/ and frontend/my-app/).
# backend/.gitignore and frontend/my-app/.gitignore still apply inside their folders.

# ---------------------------------------------------------------------------
# Secrets: never commit. Only the .env.example templates are tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key

# ---------------------------------------------------------------------------
# Dependencies (reinstalled with `npm ci`)
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output (rebuilt on the server with `npm run build`)
# ---------------------------------------------------------------------------
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts
.vercel/
coverage/

# ---------------------------------------------------------------------------
# Supabase CLI local state (project link, temp files). Migrations stay tracked.
# ---------------------------------------------------------------------------
**/supabase/.temp/
**/supabase/.branches/

# ---------------------------------------------------------------------------
# Logs and debugging
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
