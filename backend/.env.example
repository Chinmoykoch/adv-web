PORT=5000
NODE_ENV=development

# Supabase project (Project Settings -> API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server-only, bypasses row-level security. Never expose or commit.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Website origin(s) allowed to call the API, comma separated
FRONTEND_URL=http://localhost:3000
# Random string of 32+ characters, shared with the Next app (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
REVALIDATE_SECRET=
# Reverse proxies in front of the API in production (usually 1), so rate limits see real visitor IPs
TRUST_PROXY=0

# Optional Google Business Profile reviews integration (server-only).
# Requires approved Business Profile API access and an owner/manager OAuth grant.
# Use your own OAuth client to obtain an offline refresh token with business.manage scope.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Google resource name, NOT a Maps Place ID.
# Example: accounts/123456789/locations/987654321
GOOGLE_BUSINESS_LOCATION=
# The business's public Google Maps listing; shown as attribution on the website.
GOOGLE_BUSINESS_MAPS_URL=https://maps.app.goo.gl/oiKsf6HrPQ3C23eG9
