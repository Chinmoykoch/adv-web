PORT=5000
NODE_ENV=development

# Supabase project (Project Settings -> API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server-only, bypasses row-level security. Never expose or commit.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Website origin(s) allowed to call the API, comma separated
FRONTEND_URL=http://localhost:3000
# Random string of 32+ characters, shared with the Next app (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
REVALIDATE_SECRET=
# Reverse proxies in front of the API in production (usually 1), so rate limits see real visitor IPs
TRUST_PROXY=0
